<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>CFHodEd.Tests.Godot</RootNamespace>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="gdUnit4.test.adapter" Version="3.0.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="gdUnit4.api" Version="5.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../HW2HOD/HW2HOD.csproj" />
  </ItemGroup>

  <!-- Copy the HOD test fixture for integration tests -->
  <ItemGroup>
    <Content Include="..\..\test\meg_starjumper.hod">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>TestData\meg_starjumper.hod</Link>
    </Content>
  </ItemGroup>
</Project>
